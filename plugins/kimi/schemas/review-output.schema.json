{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yysu/kimi-plugin-cc/schemas/review-output.schema.json",
  "title": "Kimi review output",
  "description": "Structured payload Kimi must emit at the end of a review run.",
  "type": "object",
  "required": ["verdict", "summary", "findings", "next_steps"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "needs-attention", "block"],
      "description": "pass = ship-ready; needs-attention = non-blocking concerns; block = at least one critical issue."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "body", "confidence"],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "nit"]
          },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "file": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "scope-violation",
              "missing-criterion",
              "design",
              "performance",
              "testing",
              "style"
            ]
          },
          "recommendation": { "type": "string" }
        }
      }
    },
    "scope_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files_outside_whitelist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "out_of_scope_violations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_criteria": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
